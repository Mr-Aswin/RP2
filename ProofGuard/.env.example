# ProofGuard Environment Configuration Template
# Copy to .env and adjust as necessary for your local environment

# Optional custom Tesseract binary path (default auto-detected on Windows/Linux)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# SQLite Database URL (defaults to proofguard.db in project root)
# DATABASE_URL=sqlite:///proofguard.db

# CPSC API Base URL
# CPSC_API_BASE=https://www.saferproducts.gov/RestWebServices/Recall
